# ───── IRB-Ultimate environment ─────
# Copy to .env and fill in. .env is git-ignored.

# Runtime
NODE_ENV=development
PORT=3000

# Database — MySQL 8+
# Example: mysql://user:pass@127.0.0.1:3306/irb_platform
DATABASE_URL=mysql://root@127.0.0.1:3306/irb_platform

# Session / cookie signing — generate a strong random value for production
# e.g. openssl rand -hex 48
JWT_SECRET=change-me-to-a-strong-random-secret

# App identifier (used in cookie/JWT claims). Any non-empty string works locally.
VITE_APP_ID=irb-ultimate-local

# OpenID of the platform owner — auto-promoted to admin on first login.
# In dev login, set this to the same openId you sign in with.
OWNER_OPEN_ID=dev-owner-001

# OAuth provider (optional — legacy Manus gateway)
# Leave blank when using Supabase Auth (recommended).
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
OAUTH_PORTAL_URL=

# Supabase Auth — Google, Apple, and email/password (recommended for production)
# Project: https://supabase.com/dashboard/project/andqzedqoiduqxynoaeq
# Enable providers under Authentication → Providers; add redirect URLs:
#   https://irb-saudi-arabia.vercel.app/auth/callback
#   http://localhost:3000/auth/callback
SUPABASE_URL=https://andqzedqoiduqxynoaeq.supabase.co
VITE_SUPABASE_URL=https://andqzedqoiduqxynoaeq.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Platform owner. OWNER_EMAIL is promoted to admin ONLY as a one-time
# bootstrap when no admin account exists yet (it can't be re-claimed later).
# Set it to YOUR real email in the live environment, register that account
# first, then everything else is granted by an admin. Never commit a real
# address here.
OWNER_OPEN_ID=
OWNER_EMAIL=owner@example.com

# ───── Origin allowlist (SA-01 / SA-20) ─────
# Comma-separated origins permitted to make state-changing /api/trpc calls.
# Required in the split-domain deploy (SPA on Vercel, API on Render).
# Same-origin requests are always allowed.
#   ALLOWED_ORIGINS=https://irb-saudi-arabia.vercel.app,https://irb-saudi-arabia.onrender.com
ALLOWED_ORIGINS=

# Public URLs (Render + Vercel). See PUBLIC_DEPLOY.md.
# PUBLIC_APP_URL=https://irb-saudi-arabia.vercel.app
# VITE_PUBLIC_SITE_URL=https://irb-saudi-arabia.vercel.app
# DATABASE_URL for TiDB Cloud Serverless should include ?ssl=true
# Additional hosts the SPA's connect-src CSP allows (Sentry, analytics).
ALLOWED_CONNECT_HOSTS=

# ───── Pilot / dev sign-in ─────
# SECURITY: open passwordless sign-in in production has been removed.
# Production identity = Supabase, OAuth, or native email/password.
# For a controlled demo pilot only, set PILOT_LOGIN_ENABLED=1 with a strong
# out-of-band token (>= 32 chars): openssl rand -hex 24
# PILOT_LOGIN_ENABLED=
# PILOT_LOGIN_TOKEN=
# PUBLIC_APP_URL=https://irb-saudi-arabia.vercel.app
# DATABASE_POOL_MAX=30
# OFF by default. Set DEV_LOGIN_ENABLED=1 to enable in non-production.
# DEV_LOGIN_TOKEN, when set, must match a `token` field on the POST body even
# from loopback — protects against accidental tunnel exposure.
DEV_LOGIN_ENABLED=
DEV_LOGIN_TOKEN=

# ───── LLM budget (SA-03) ─────
# Per-user daily call cap (rolls over UTC midnight) and platform-wide cap.
# A compromised cookie / runaway loop can't burn more than these.
LLM_USER_DAILY_LIMIT=200
LLM_GLOBAL_DAILY_LIMIT=10000

# Forge gateway — used for non-LLM features (S3 proxy, push, maps, data API).
# Optional. Leave blank if you don't use Forge.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# LLM endpoint — OpenAI-compatible /v1/chat/completions.
# Falls back to BUILT_IN_FORGE_API_URL/KEY when these are blank.
# When blank / credits exhausted, Stage 1/2 return [AI_UNAVAILABLE] (app can still proceed).
#
# Tested working examples:
#   LLM_API_URL=https://api.minimax.io           LLM_MODEL=MiniMax-M3
#   LLM_API_URL=https://api.minimax.io           LLM_MODEL=MiniMax-M2.5
#   LLM_API_URL=https://api.openai.com           LLM_MODEL=gpt-4o-mini
#   LLM_API_URL=https://api.anthropic.com        LLM_MODEL=claude-haiku-4-5  LLM_PROVIDER=anthropic
#
# LLM_PROVIDER controls payload shape (openai | anthropic | claude).
# Interactive AI (review/enhance) uses LLM_FAST_MAX_TOKENS + LLM_THINKING=disabled
# for MiniMax-M3 (large latency win). Deep jobs (swarm/proposals) use LLM_MAX_TOKENS.
# LLM_DEBUG=1 to log raw LLM responses (helpful for debugging providers).
# Verify: PORT=3010 node scripts/check-ai.mjs  (or owner /admin/observability AI card)
# Never commit real LLM_API_KEY values — set them in Render / local .env only.
LLM_API_URL=https://api.minimax.io
LLM_API_KEY=
LLM_MODEL=MiniMax-M3
LLM_MAX_TOKENS=8192
LLM_FAST_MAX_TOKENS=4096
LLM_THINKING=disabled
LLM_TIMEOUT_MS=90000
LLM_PROVIDER=openai
LLM_DEBUG=

# S3 (file uploads / certificates) — leave blank to disable; uploads will fail gracefully.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=

# SMTP (email notifications) — optional; emails are no-ops if blank.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM="IRB Ultimate <noreply@example.com>"

# ───── Public site metadata (build-time, VITE_ prefix) ─────
# Canonical URL injected into <head> when set (no trailing slash needed).
# VITE_PUBLIC_SITE_URL=https://irb.example.sa
# Demo/pilot banner — shows EN/AR notice on every page. Use for non-resident
# demo deploys that must NOT accept real PHI (see DEPLOY.md Option A).
# VITE_PUBLIC_DEMO_BANNER=1
# Optional Umami analytics (both required to enable).
# VITE_ANALYTICS_ENDPOINT=https://analytics.example.com
# VITE_ANALYTICS_WEBSITE_ID=your-website-id

# ───── Literature & evidence sources ─────
# Power the Stage 2 cross-check (and the public literature.search API).
# All optional — any missing source silently degrades. No key needed for
# ClinicalTrials.gov.
PUBMED_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_API_KEY=
# Elicit's API surface is partner-gated; set both URL and key once
# Elicit support confirms the right endpoint for your plan.
ELICIT_API_KEY=
ELICIT_API_URL=
