# ───── IRB-Ultimate environment ─────
# Copy to .env and fill in. .env is git-ignored.

# Runtime
NODE_ENV=development
PORT=3000

# Database — MySQL 8+
# Example: mysql://user:pass@127.0.0.1:3306/irb_platform
DATABASE_URL=mysql://root@127.0.0.1:3306/irb_platform

# Session / cookie signing — generate a strong random value for production
# e.g. openssl rand -hex 48
JWT_SECRET=change-me-to-a-strong-random-secret

# App identifier (used in cookie/JWT claims). Any non-empty string works locally.
VITE_APP_ID=irb-ultimate-local

# OpenID of the platform owner — auto-promoted to admin on first login.
# In dev login, set this to the same openId you sign in with.
OWNER_OPEN_ID=dev-owner-001

# OAuth provider (optional)
# Leave blank to use the local /api/dev/login bypass during development.
# Point to your hosted OAuth gateway in production.
OAUTH_SERVER_URL=
# Public-facing OAuth portal that the SPA redirects users to (build-time var)
VITE_OAUTH_PORTAL_URL=

# Forge gateway — used for non-LLM features (S3 proxy, push, maps, data API).
# Optional. Leave blank if you don't use Forge.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# LLM endpoint — OpenAI-compatible /v1/chat/completions.
# Falls back to BUILT_IN_FORGE_API_URL/KEY when these are blank.
# When blank everywhere, AI review uses neutral defaults (no LLM call).
#
# Tested working examples:
#   LLM_API_URL=https://api.minimax.io           LLM_MODEL=MiniMax-M2
#   LLM_API_URL=https://api.openai.com           LLM_MODEL=gpt-4o-mini
#   LLM_API_URL=https://api.anthropic.com        LLM_MODEL=claude-haiku-4-5  LLM_PROVIDER=anthropic
#
# LLM_PROVIDER controls payload shape (openai | anthropic | claude).
# LLM_MAX_TOKENS — reasoning models (M2, R1) burn most of the budget on
# <think> tokens. With literature context injected into Stage 2 the prompt
# is large; bump to 24576 so the JSON tail isn't truncated. The aiReview
# parser tolerates truncation but a clean response is always better.
# LLM_DEBUG=1 to log raw LLM responses (helpful for debugging providers).
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=MiniMax-M2
LLM_MAX_TOKENS=24576
LLM_PROVIDER=openai
LLM_DEBUG=

# S3 (file uploads / certificates) — leave blank to disable; uploads will fail gracefully.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=

# SMTP (email notifications) — optional; emails are no-ops if blank.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM="IRB Ultimate <noreply@example.com>"

# ───── Literature & evidence sources ─────
# Power the Stage 2 cross-check (and the public literature.search API).
# All optional — any missing source silently degrades. No key needed for
# ClinicalTrials.gov.
PUBMED_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_API_KEY=
# Elicit's API surface is partner-gated; set both URL and key once
# Elicit support confirms the right endpoint for your plan.
ELICIT_API_KEY=
ELICIT_API_URL=
