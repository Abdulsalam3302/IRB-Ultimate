# IRB Ultimate 2.2.0 — safe local template. Never commit .env or real credentials.
# Node 24.x / pnpm 10.34.5. All VITE_ values are public browser/build configuration.
NODE_ENV=development
PORT=3000
VITE_APP_ID=irb-ultimate-local

# Provision a dedicated development database. CI/tests use a different loopback
# database ending in _test, supplied explicitly on the command line (see README).
DATABASE_URL=mysql://irb_dev:replace_local_password@127.0.0.1:3306/irb_platform_dev
DATABASE_POOL_MAX=5
DATABASE_QUEUE_MAX=50
# Generate with openssl rand -hex 48; production refuses weak/placeholder secrets.
JWT_SECRET=

# Approval remains disabled until institution/committee authority and acceptance.
IRB_ISSUANCE_ENABLED=false
# Production staff require a signed Supabase aal2 session. Do not disable publicly.
STAFF_MFA_REQUIRED=true
# Exact verified provider identity. Supabase format: sb:<user-subject-uuid>.
# For a disposable developer login only: dev-owner-001.
OWNER_OPEN_ID=
OWNER_EMAIL=

# Public origins: set all to the actual HTTPS public origin for production.
# VITE_PUBLIC_SITE_URL is needed when BUILDING public SEO pages.
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_SITE_URL=
VITE_PUBLIC_SITE_URL=
ALLOWED_ORIGINS=http://localhost:3000
# Development direct connection = 0; production must match verified ingress hops.
TRUST_PROXY_HOPS=0
# Optional additional CSP origins; keep narrow. Vercel CSP is configured separately.
ALLOWED_CONNECT_HOSTS=
ALLOWED_IMG_HOSTS=
# Comma-separated approved outbound hostnames. Also enforce network egress policy.
ALLOWED_EGRESS_HOSTS=

# Institutional Supabase Auth. Use the same project in frontend and backend;
# enroll staff MFA and configure exact /auth/callback redirect URLs.
SUPABASE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional legacy OAuth gateway. Leave blank when not using it.
OAUTH_SERVER_URL=
OAUTH_PORTAL_URL=
VITE_OAUTH_PORTAL_URL=

# Explicit local development login only; always disabled in production.
DEV_LOGIN_ENABLED=0
DEV_LOGIN_TOKEN=
# Controlled synthetic pilot exception only, disabled by default. Never public auth.
PILOT_LOGIN_ENABLED=0
PILOT_LOGIN_TOKEN=

# AI kill switch: 0 disables processing; set 1 after provider/data-flow approval.
AI_ENABLED=0
# Current transport supports OpenAI-compatible chat completions, not native Anthropic.
# Example base URL: https://api.openai.com (select an entitled model separately).
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_PROVIDER=openai
LLM_MAX_TOKENS=8192
LLM_FAST_MAX_TOKENS=4096
LLM_THINKING=disabled
LLM_TIMEOUT_MS=90000
LLM_MAX_CONCURRENCY=6
# Persistent daily call ceilings, UTC reset. Also set provider currency spend limits.
LLM_USER_DAILY_LIMIT=40
LLM_GLOBAL_DAILY_LIMIT=500

# Optional Forge integration: storage/push/maps and LLM fallback. If both Forge
# credentials are set, storage selects Forge before S3; review its contracts/policy.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Private durable AWS S3 storage. Block public access and configure IAM, retention,
# versioning and region policy. Driver requests AES256 encryption and short URLs.
# Arbitrary S3 endpoints/KMS are not currently exposed by this driver.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
# Development disk fallback. Production requires an explicit durable private volume
# exception; never enable this on an ephemeral public host for real records.
ALLOW_LOCAL_STORAGE=false
UPLOADS_DIR=
PDF_MAX_CONCURRENCY=1

# Production scanning is required by default. Blank preserves environment default:
# required in production, optional in development. Set true explicitly on production.
# Missing/unavailable scanner rejects production uploads; false is isolated-test only.
UPLOAD_SCAN_REQUIRED=
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_SCAN_TIMEOUT_MS=15000
CLAMAV_MAX_CONCURRENT=4

# Literature discovery. No key needed for ClinicalTrials.gov. Missing/configuration
# failures remain unavailable rather than fabricated zero-result or complete evidence.
PUBMED_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_API_KEY=
ELICIT_API_KEY=
ELICIT_API_URL=

# Backup utilities: schedule separately and test restoration into an isolated target.
# Institution sets retention; configure object lifecycle separately from local pruning.
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
# Encryption is mandatory; GPG recipient or >=20-char passphrase. New .enc uses
# authenticated AES-256-GCM and a required .sha256 sidecar. Store keys separately.
BACKUP_GPG_RECIPIENT=
BACKUP_PASSPHRASE=
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=irb-ultimate/mysql
# Required path to a trusted CA certificate for remote DB backup/restore.
BACKUP_DB_SSL_CA=

# Optional privacy-reviewed observability; keep blank until processor approval.
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_ENVIRONMENT=
# Public pilot banner. Removing a banner does not establish public readiness.
VITE_PUBLIC_DEMO_BANNER=1
# Optional analytics/ads: no sensitive data, explicit policy/consent review required.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
VITE_GTM_ID=

# No SMTP transport is implemented. emailService.ts stores in-app notifications;
# optional Forge owner push sends only a generic sign-in notice, not research data.
# ALLOW_LOCAL_TEST_DB is intentionally omitted: only isolated CI production-mode
# tests may set it to 1 with a loopback _test database and explicit ssl=false.

# Bound model concurrency on the current small pilot instance.
LLM_MAX_CONCURRENCY=2

# Enable only after institutional publication/privacy review.
PUBLIC_REGISTRY_ENABLED=false

# On Render, share the browser installation between build and runtime.
# PLAYWRIGHT_BROWSERS_PATH=/opt/render/project/.cache/playwright
