  "scripts": {
    "dev": "NODE_ENV=development tsx watch server/_core/index.ts",
    "build": "vite build && tsx scripts/build-public-pages.ts && esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist && cp -r server/templates dist/templates",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "e2e:roles": "node scripts/e2e-roles.mjs",
    "db:push": "drizzle-kit generate && tsx scripts/migrate.ts",
    "db:migrate": "tsx scripts/migrate.ts"
  },
