{
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist/public",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://irb-saudi-arabia.onrender.com/api/:path*"
    },
    {
      "source": "/mcp",
      "destination": "https://irb-saudi-arabia.onrender.com/mcp"
    },
    {
      "source": "/.well-known/mcp.json",
      "destination": "https://irb-saudi-arabia.onrender.com/.well-known/mcp.json"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://irb-saudi-arabia.onrender.com/uploads/:path*"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/sign-in",
      "destination": "/auth",
      "permanent": false
    },
    {
      "source": "/login",
      "destination": "/auth",
      "permanent": false
    }
  ]
}
